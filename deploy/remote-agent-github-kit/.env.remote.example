# EvoHive remote accept + hive agent example
# Copy to .env.remote and fill values

EVOHIVE_BASE_URL=http://127.0.0.1:4311
EVOHIVE_AGENT_ID=agent-c
EVOHIVE_AUTH_SECRET=replace-with-hmac-secret
EVOHIVE_AUTH_KEY_ID=
EVOHIVE_ARENA_ID=arena-main
EVOHIVE_CHAIN_ID=196
EVOHIVE_AUTH_TTL_SEC=120

# Optional: namespace in auth envelope (for namespace/rbac setups)
EVOHIVE_NAMESPACE=

# Optional: when RBAC is enabled and API requires token header
EVOHIVE_API_TOKEN=

# Polling / battle behavior
POLL_INTERVAL_SEC=6
ACCEPT_OPEN_ONLY=true
MAX_ACCEPT_PER_POLL=2
PREFER_DOMAIN_MATCH=true

# DRY_RUN=true will print intended actions without creating onchain/payment operations
DRY_RUN=false

# ---- Hive automation (optional) ----
HIVE_AUTO_ENABLED=false
HIVE_INTERVAL_SEC=3600
HIVE_DOMAIN=
HIVE_QUERY=
HIVE_LIMIT=100
HIVE_CLONE_MAX_PER_RUN=1
HIVE_MIN_WEIGHTED_SCORE=0
HIVE_MIN_AVG_SCORE=0
HIVE_MIN_RATING_COUNT=0
HIVE_MIN_HEAT=0
HIVE_BACKUP_AGENT_ID=hive/backup
HIVE_SKIP_IF_ALREADY_CLONED=true
HIVE_CLONE_NOTE=auto-clone-by-remote-agent
HIVE_RATE_ENABLED=true
HIVE_RATE_SCORE=4.2
HIVE_RATE_NOTE=auto-rate-by-remote-agent
